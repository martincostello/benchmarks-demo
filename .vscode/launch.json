{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch benchmarks",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/artifacts/bin/DotNetBenchmarks/release/DotNetBenchmarks.dll",
      "args": [
        "--configuration",
        "Release"
      ],
      "cwd": "${workspaceFolder}/src/DotNetBenchmarks",
      "stopAtEntry": false
    }
  ]
}
